---
import BaseLayout from "./BaseLayout.astro";
const { frontmatter } = Astro.props;

const formattedDate = new Intl.DateTimeFormat("en-US", {
  month: "long",
  day: "2-digit",
  year: "numeric"
}).format(new Date(frontmatter.date));
---

<BaseLayout
    pageTitle={frontmatter.title},
    pageDescription={frontmatter.excerpt},
    pageImage={frontmatter.heroImg},
    pageUrl={Astro.url.href},
    bodyId = "blog",
    bodyClass = "teamdirt article grid p-4 m-auto my-4 border",
    mainClass = {frontmatter.mainClass},
>
    <header id="blog-heading" class="text-center">
        <h1>
            <mark class="mono mb-2 d-inline-block">{frontmatter.category}:</mark><br> <span class="fw-bold">{frontmatter.title}</span>
        </h1>

        <div class="my-2">
            <span class="text-secondary mono">{frontmatter.author}, {frontmatter.position} for Team Dirt on <span>{formattedDate}</span> <br>{frontmatter.supportcopy}</span>
        </div>
    </header>

    <div class="hero-wrapper">
        <img src={frontmatter.heroImg} class="img-fluid" alt="Hero Image">
    </div>
    <slot />
</BaseLayout>